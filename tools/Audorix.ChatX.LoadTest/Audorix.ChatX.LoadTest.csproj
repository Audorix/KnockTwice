<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Load test (Phase 22). A stand-alone client: it talks to an installation only through the public
    HTTP API and the realtime hub, so it can be pointed at any server. See docs/guides/load-testing.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

</Project>
