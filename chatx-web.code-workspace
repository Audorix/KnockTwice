{
  // VS Code workspace for the React frontend (web/). Open with: File > Open Workspace from File...
  // The API runs separately (see docs/development/getting-started.md); the Vite dev server
  // proxies /api, /health, /openapi and /swagger to http://localhost:5080.
  "folders": [
    { "name": "chat-web (@audorix/chatx-web)", "path": "web/apps/chat-web" },
    { "name": "web (npm workspace root)", "path": "web" }
  ],
  "settings": {
    // The project uses TypeScript 7 (native compiler, no tsserver.js). The TypeScript Native
    // Preview extension provides matching language support; without it VS Code falls back to
    // its bundled TypeScript, while `npm run typecheck` stays the source of truth.
    "typescript.experimental.useTsgo": true,
    "typescript.preferences.importModuleSpecifier": "relative",
    "typescript.preferences.quoteStyle": "single",
    "javascript.preferences.quoteStyle": "single",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[typescript]": { "editor.defaultFormatter": "vscode.typescript-language-features" },
    "[typescriptreact]": { "editor.defaultFormatter": "vscode.typescript-language-features" },
    "[json]": { "editor.defaultFormatter": "vscode.json-language-features" },
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/*.tsbuildinfo": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/package-lock.json": true
    },
    "npm.packageManager": "npm",
    // i18n Ally: show EN/ES strings inline (keys are kept identical by src/i18n/i18n.test.ts).
    "i18n-ally.localesPaths": ["src/i18n/locales"],
    "i18n-ally.pathMatcher": "{locale}.json",
    "i18n-ally.keystyle": "nested",
    "i18n-ally.sourceLanguage": "en"
  },
  "extensions": {
    "recommendations": [
      "TypeScriptTeam.native-preview",
      "vitest.explorer",
      "editorconfig.editorconfig",
      "lokalise.i18n-ally"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "web: dev server",
        "type": "shell",
        "command": "npm run dev",
        "options": { "cwd": "${workspaceFolder:chat-web (@audorix/chatx-web)}" },
        "isBackground": true,
        "problemMatcher": {
          "owner": "vite",
          "pattern": { "regexp": "^__never_matches__$" },
          "background": {
            "activeBegins": "VITE",
            "endsPattern": "Local:\\s+http://localhost:5173"
          }
        }
      },
      {
        "label": "web: install (npm ci)",
        "type": "shell",
        "command": "npm ci",
        "options": { "cwd": "${workspaceFolder:web (npm workspace root)}" },
        "problemMatcher": []
      },
      {
        "label": "web: typecheck",
        "type": "shell",
        "command": "npm run typecheck",
        "options": { "cwd": "${workspaceFolder:chat-web (@audorix/chatx-web)}" },
        "problemMatcher": "$tsc",
        "group": "build"
      },
      {
        "label": "web: test",
        "type": "shell",
        "command": "npm test",
        "options": { "cwd": "${workspaceFolder:chat-web (@audorix/chatx-web)}" },
        "problemMatcher": [],
        "group": "test"
      },
      {
        "label": "web: build",
        "type": "shell",
        "command": "npm run build",
        "options": { "cwd": "${workspaceFolder:chat-web (@audorix/chatx-web)}" },
        "problemMatcher": "$tsc",
        "group": { "kind": "build", "isDefault": true }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug chat-web in Edge",
        "type": "msedge",
        "request": "launch",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder:chat-web (@audorix/chatx-web)}",
        "preLaunchTask": "web: dev server"
      },
      {
        "name": "Debug chat-web in Chrome",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder:chat-web (@audorix/chatx-web)}",
        "preLaunchTask": "web: dev server"
      }
    ]
  }
}
