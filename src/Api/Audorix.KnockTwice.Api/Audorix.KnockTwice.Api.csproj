<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Audorix.KnockTwice.Api</RootNamespace>
    <!-- Kept until 2.0: operators run "dotnet Audorix.ChatX.Api.dll" (systemd units, migrate, grant-role). -->
    <AssemblyName>Audorix.ChatX.Api</AssemblyName>
    <UserSecretsId>audorix-chatx-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The localizer finds resources by assembly name unless told otherwise; they are embedded
         under the root namespace, which differs from the assembly name kept above. -->
    <AssemblyAttribute Include="Microsoft.Extensions.Localization.RootNamespaceAttribute">
      <_Parameter1>Audorix.KnockTwice.Api</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Composition root: the only project that references every adapter. -->
    <ProjectReference Include="..\..\Core\Audorix.KnockTwice.Application\Audorix.KnockTwice.Application.csproj" />
    <ProjectReference Include="..\..\Core\Audorix.KnockTwice.Contracts\Audorix.KnockTwice.Contracts.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Audorix.KnockTwice.Infrastructure\Audorix.KnockTwice.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Audorix.KnockTwice.Persistence.Sqlite\Audorix.KnockTwice.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Audorix.KnockTwice.Persistence.PostgreSql\Audorix.KnockTwice.Persistence.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <!-- UI only: the document itself is generated by Microsoft.AspNetCore.OpenApi. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!-- Optional scale-out (Phase 21): only used when ScaleOut:Redis is configured. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Audorix.KnockTwice.UnitTests" />
    <InternalsVisibleTo Include="Audorix.KnockTwice.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.*.json" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="App_Data\**" />
    <Content Remove="App_Data\**" />
  </ItemGroup>

</Project>
