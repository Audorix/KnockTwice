{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Database": {
    "//": "Development applies pending migrations at startup. Production uses the explicit 'migrate' command.",
    "MigrateOnStartup": true
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5173"
  },
  "Captcha": {
    "Provider": "Turnstile",
    "Turnstile": {
      "//": "Cloudflare's published test keys: the widget always passes. Development only.",
      "SiteKey": "1x00000000000000000000AA",
      "SecretKey": "1x0000000000000000000000000000000AA"
    }
  },
  "DemoData": {
    "Enabled": true,
    "AvatarsPath": "../../../demo/avatars"
  },
  "OpenApi": {
    "Enabled": true
  }
}
