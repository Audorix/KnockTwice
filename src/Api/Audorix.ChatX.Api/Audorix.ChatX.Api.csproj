<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Audorix.ChatX.Api</RootNamespace>
    <UserSecretsId>audorix-chatx-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Composition root: the only project that references every adapter. -->
    <ProjectReference Include="..\..\Core\Audorix.ChatX.Application\Audorix.ChatX.Application.csproj" />
    <ProjectReference Include="..\..\Core\Audorix.ChatX.Contracts\Audorix.ChatX.Contracts.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Audorix.ChatX.Infrastructure\Audorix.ChatX.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Audorix.ChatX.Persistence.Sqlite\Audorix.ChatX.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Audorix.ChatX.Persistence.PostgreSql\Audorix.ChatX.Persistence.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <!-- UI only: the document itself is generated by Microsoft.AspNetCore.OpenApi. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!-- Optional scale-out (Phase 21): only used when ScaleOut:Redis is configured. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Audorix.ChatX.UnitTests" />
    <InternalsVisibleTo Include="Audorix.ChatX.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.*.json" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="App_Data\**" />
    <Content Remove="App_Data\**" />
  </ItemGroup>

</Project>
