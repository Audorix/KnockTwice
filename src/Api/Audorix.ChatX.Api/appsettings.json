{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Setup": {
    "Completed": false,
    "SettingsPath": "App_Data/chatx.settings.json"
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "Database": {
    "Provider": "",
    "ConnectionString": ""
  },
  "Localization": {
    "DefaultLanguage": "en",
    "SupportedLanguages": []
  },
  "Identity": {
    "AllowRegistration": true,
    "RequireConfirmedEmail": true,
    "AutoConfirmEmail": false,
    "PasswordMinimumLength": 10,
    "MaxFailedAccessAttempts": 5,
    "LockoutDuration": "00:15:00",
    "SessionLifetime": "12:00:00",
    "PersistentSessionLifetime": "14.00:00:00",
    "TokenLifetime": "1.00:00:00"
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@chatx.localhost",
    "FromName": "Audorix.ChatX",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    },
    "Postmark": {
      "MessageStream": "outbound"
    }
  },
  "Captcha": {
    "Provider": "Turnstile",
    "Turnstile": {
      "SiteKey": "",
      "SecretKey": ""
    }
  },
  "Authentication": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Microsoft": { "ClientId": "", "ClientSecret": "" }
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "AuthWindow": "00:01:00"
  },
  "Realtime": {
    "PresenceOfflineGrace": "00:00:05",
    "TypingTimeout": "00:00:06",
    "SweepInterval": "00:00:01",
    "SessionCheckInterval": "00:00:30"
  },
  "Messaging": {
    "EditWindow": "00:15:00",
    "MaxLength": 4000
  },
  "Attachments": {
    "MaxFileSize": 26214400,
    "MaxPerMessage": 10,
    "UserQuota": 1073741824,
    "AllowedExtensions": [],
    "AbandonedAfter": "1.00:00:00",
    "PendingTimeout": "01:00:00",
    "CleanupInterval": "00:01:00"
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "Path": "App_Data/attachments"
    },
    "S3": {
      "Endpoint": "",
      "Region": "us-east-1",
      "Bucket": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "ForcePathStyle": true,
      "Prefix": ""
    }
  },
  "Scanning": {
    "Provider": "None",
    "ClamAv": {
      "Host": "localhost",
      "Port": 3310,
      "Timeout": "00:00:30"
    }
  },
  "PrivateChats": {
    "Enabled": true,
    "InvitationTimeout": "00:10:00",
    "MaxMessages": 1000,
    "MaxFileSize": 10485760,
    "MaxBytesPerChat": 52428800,
    "MaxActivePerUser": 5
  },
  "DemoData": {
    "Enabled": false
  },
  "OpenApi": {
    "Enabled": false
  }
}
