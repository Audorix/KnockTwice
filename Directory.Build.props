<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Authors>Knock Twice contributors</Authors>
    <Company>Audorix</Company>
    <Copyright>Copyright (c) 2026 Audorix</Copyright>
    <Product>Knock Twice</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Audorix/KnockTwice</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- CA1848/CA1873: LoggerMessage source generators are not required for the foundation's few log sites. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>
</Project>
