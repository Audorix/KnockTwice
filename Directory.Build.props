<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
    <Authors>Audorix.ChatX contributors</Authors>
    <Product>Audorix.ChatX</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- CA1848/CA1873: LoggerMessage source generators are not required for the foundation's few log sites. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>
</Project>
