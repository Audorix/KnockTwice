# Copy to docker/.env (git-ignored) and adjust. Contains no real secrets.
# Docker Compose reads docker/.env automatically for files in this directory.

# Required by compose.postgres.yaml. Choose any local development password.
CHATX_POSTGRES_PASSWORD=

# Host ports (defaults shown).
CHATX_WEB_PORT=8080
CHATX_API_PORT=5080

# ASP.NET Core environment for the API containers. Development enables /openapi/v1.json.
CHATX_ENVIRONMENT=Development
