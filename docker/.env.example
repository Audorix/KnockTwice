# Copy to docker/.env (git-ignored) and adjust. Contains no real secrets.
# Docker Compose reads docker/.env automatically for files in this directory.

# Required by compose.postgres.yaml. Choose any local development password (no ';').
CHATX_POSTGRES_PASSWORD=

# Host ports (defaults shown). Mailpit's web UI shows development email.
CHATX_WEB_PORT=8080
CHATX_API_PORT=5080
CHATX_MAILPIT_PORT=8025

# ASP.NET Core environment for the API containers. Development enables /openapi and /swagger
# and offers Cloudflare's always-pass Turnstile test keys in the setup wizard.
CHATX_ENVIRONMENT=Development

# Web address, email (SMTP via the bundled Mailpit: host "mailpit", port 1025, or Postmark),
# captcha and development mode are chosen in the setup wizard on first start. The setup code
# is printed by the API: docker compose -f docker/compose.sqlite.yaml logs api
