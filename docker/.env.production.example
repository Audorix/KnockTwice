# Copy to docker/.env.production (git-ignored), fill in, and pass with --env-file.
# Contains no real secrets. Keep the real file readable only by the operators.

# Host port nginx listens on, bound to 127.0.0.1. Point your TLS reverse proxy here.
CHATX_WEB_PORT=8080

# Optional: use prebuilt images instead of building locally.
# CHATX_API_IMAGE=registry.example.org/audorix/chatx-api:1.1.0
# CHATX_WEB_IMAGE=registry.example.org/audorix/chatx-web:1.1.0

# The PostgreSQL bootstrap password is read from docker/secrets/postgres_password. The wizard
# asks for the matching database connection on first start, then stores it in the private
# persistent settings file. Its setup code is in the API log:
#   docker compose -f docker/compose.production.yaml --env-file docker/.env.production logs api
# Values in this file only fill ${...} placeholders in the compose file. To configure the database
# through a secret file or environment key instead of the wizard, see docs/deployment-docker.md.
