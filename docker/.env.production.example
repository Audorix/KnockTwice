# Copy to docker/.env.production (git-ignored), fill in, and pass with --env-file.
# Contains no real secrets. Keep the real file readable only by the operators.

# Required. Long random value without ';' (it is embedded in a connection string), e.g.
#   openssl rand -base64 32 | tr -d ';/+='
CHATX_POSTGRES_PASSWORD=

# Host port nginx listens on, bound to 127.0.0.1. Point your TLS reverse proxy here.
CHATX_WEB_PORT=8080

# Optional: use prebuilt images instead of building locally.
# CHATX_API_IMAGE=registry.example.org/audorix/chatx-api:1.0.0
# CHATX_WEB_IMAGE=registry.example.org/audorix/chatx-web:1.0.0

# Everything else (public web address, email provider, captcha keys, first administrator) is
# entered in the setup wizard on first start. Its setup code is in the API log:
#   docker compose -f docker/compose.production.yaml --env-file docker/.env.production logs api
# Values in this file only fill ${...} placeholders in the compose file. To configure providers
# with environment variables instead of the wizard (for example Email__Smtp__Password), add them
# to the api and migrate services in a compose override file; see docs/deployment-docker.md.
